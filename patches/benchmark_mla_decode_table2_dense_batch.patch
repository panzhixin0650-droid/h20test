+def validate_tensor(output: torch.Tensor, expected_shape: tuple[int, ...]) -> dict[str, Any]:
+    torch.cuda.synchronize()
+    actual_shape = tuple(output.shape)
+    if actual_shape != expected_shape:
+        raise RuntimeError(f"Expected output shape {expected_shape}, got {actual_shape}")
+    finite = bool(torch.isfinite(output).all().item())
+    if not finite:
+        raise RuntimeError("Output contains NaN or Inf")
+    return {
+        "shape": list(actual_shape),
+        "dtype": str(output.dtype),
+        "finite": finite,
+    }
 
