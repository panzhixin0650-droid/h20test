+def profile_kernels(
+    fn: Callable[[], Any],
+    *,
+    num_tests: int,
+    flush_l2: bool,
+) -> dict[str, Any]:
+    kernelkit = import_official_profiler()
+    if kernelkit is None:
+        raise RuntimeError("Official FlashMLA kernelkit profiler is unavailable")
+    profile = kernelkit.bench_kineto(fn, num_tests=num_tests, flush_l2=flush_l2)
+    kernels = []
+    for name, ranges in profile.time_ranges.items():
+        total_seconds = sum(end - start for start, end in ranges)
+        kernels.append(
+            {
+                "name": name,
+                "invocations_total": len(ranges),
+                "invocations_per_call": len(ranges) / profile.num_tests,
+                "sum_us_per_call": total_seconds * 1_000_000.0 / profile.num_tests,
+                "mean_us_per_invocation": total_seconds * 1_000_000.0 / len(ranges),
+                "likely_target_kernel": (
+                    "flash" in name.lower()
+                    or "fmha" in name.lower()
+                    or "cutlass" in name.lower()
+                ),
+            }
+        )
+    kernels.sort(key=lambda item: item["sum_us_per_call"], reverse=True)
+    return {
+        "num_tests": profile.num_tests,
+        "flush_l2": flush_l2,
+        "kernels": kernels,
+    }
