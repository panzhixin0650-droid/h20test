+def import_official_profiler() -> Any | None:
+    benchmark_root = Path(__file__).resolve().parents[2]
+    flashmla_tests = benchmark_root / "FlashMLA" / "tests"
+    if not flashmla_tests.is_dir():
+        return None
+    sys.path.insert(0, str(flashmla_tests))
+    try:
+        import kernelkit
+
+        return kernelkit
+    except Exception:
