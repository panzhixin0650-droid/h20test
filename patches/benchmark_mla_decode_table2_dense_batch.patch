+def make_mla_inputs(
+    s_q: int,
+    seed: int,
+    batch_size: int = BATCH_SIZE,
+) -> dict[str, torch.Tensor]:
+    torch.manual_seed(seed)
+    q = torch.randn(
+        batch_size,
+        s_q,
+        NUM_HEADS_Q,
+        MLA_HEAD_DIM,
+        device=DEVICE,
+        dtype=DTYPE,
+    ) / 10
+    blocks_per_sequence = CONTEXT_LEN // 64
+    kv_cache = torch.randn(
+        batch_size * blocks_per_sequence,
+        64,
+        1,
+        MLA_HEAD_DIM,
+        device=DEVICE,
+        dtype=DTYPE,
+    ) / 10
+    block_table = torch.arange(
+        batch_size * blocks_per_sequence,
+        device=DEVICE,
+        dtype=torch.int32,
+    ).view(batch_size, blocks_per_sequence)
+    cache_seqlens = torch.full(
+        (batch_size,),
+        CONTEXT_LEN,
+        device=DEVICE,
+        dtype=torch.int32,
+    )
+    return {
+        "q": q,
+        "kv_cache": kv_cache,
+        "block_table": block_table,
+        "cache_seqlens": cache_seqlens,
+    }
+
+
+def make_mla_callable(
+    inputs: dict[str, torch.Tensor],
+) -> tuple[Callable[[], tuple[torch.Tensor, torch.Tensor]], Any]:
+    scheduler_metadata, num_splits = get_mla_metadata()
+
+    def run() -> tuple[torch.Tensor, torch.Tensor]:
+        return flash_mla_with_kvcache(
+            inputs["q"],
+            inputs["kv_cache"],
+            inputs["block_table"],
+            inputs["cache_seqlens"],
+            MLA_VALUE_DIM,
+            scheduler_metadata,
+            num_splits,
+            softmax_scale=SOFTMAX_SCALE,
+            causal=True,
+        )
+
+    return run, scheduler_metadata
+
