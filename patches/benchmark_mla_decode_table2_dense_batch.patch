+def run_flashmla_batch_sweep(
+    *,
+    s_q: int,
+    args: argparse.Namespace,
+    entry: dict[str, Any],
+    save: Callable[[], None],
+) -> None:
+    work = entry["table_work_per_sequence"]
+    for batch_size in args.batch_sizes:
+        point: dict[str, Any] = {
+            "batch_size": batch_size,
+            "status": "running",
+        }
+        entry["points"].append(point)
+        save()
+        try:
+            inputs = make_mla_inputs(
+                s_q,
+                seed=40_000 + s_q * 1_000 + batch_size,
+                batch_size=batch_size,
+            )
+            run, _ = make_mla_callable(inputs)
+            output, lse = run()
+            point["output_validation"] = validate_tensor(
+                output,
+                (batch_size, s_q, NUM_HEADS_Q, MLA_VALUE_DIM),
+            )
+            point["lse_validation"] = validate_tensor(
+                lse,
+                (batch_size, NUM_HEADS_Q, s_q),
+            )
+            time.sleep(args.batch_pre_final_sleep_s)
+            point["cold_hbm_full_call_us"] = timing_quantiles_us(
+                run,
+                warmup_ms=args.batch_final_warmup_ms,
+                rep_ms=args.batch_final_rep_ms,
+            )
+            full_call_us = point["cold_hbm_full_call_us"]["median"]
+            point["derived_from_cold_median"] = derived_batch_metrics(
+                work,
+                full_call_us,
+                s_q,
+                batch_size,
+            )
+            point["status"] = "complete"
+            print(
+                "BATCH_RESULT "
+                f"FlashMLA s_q={s_q} B={batch_size} "
+                f"full_us={full_call_us:.3f} "
+                f"us_per_seq={full_call_us / batch_size:.3f}",
+                flush=True,
+            )
+        except Exception as error:
+            point["status"] = "error"
+            point["error"] = as_error(error)
+            print(
+                "BATCH_ERROR "
+                f"FlashMLA s_q={s_q} B={batch_size}: "
+                f"{type(error).__name__}: {error}",
+                flush=True,
+            )
+        save()
+        torch.cuda.empty_cache()
+
+    point_errors = [point for point in entry["points"] if point["status"] != "complete"]
+    entry["status"] = "complete" if not point_errors else "complete_with_errors"
+    entry["error_point_count"] = len(point_errors)
+    save()
