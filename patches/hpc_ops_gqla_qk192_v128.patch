+++ b/benchmark/attention_decode/README.md
@@ -58,6 +58,27 @@ python3 benchmark/attention_decode/bench_attention_decode_fp8.py \
 
 Enable correctness comparison between static and dynamic paths with `--check`.
 
+## GQLA BF16 (`QK=192`, `V=128`)
+
+`bench_attention_decode_bf16_gqla.py` covers the four GQLA decode shapes with
+`B=128`, `L=8192`, `Hq=128`, `Hkv={8,4}`, `Sq={1,2}`, and `block_size=64`.
+It reports whole-call latency, latency divided by batch, aggregate query-token
+throughput, and physical KV-payload bandwidth. By default an 8 GiB buffer is
+written before each timed call to evict L2 without including that write in the
+CUDA-event interval.
+
+```bash
+python3 benchmark/attention_decode/bench_attention_decode_bf16_gqla.py \
+  --modes static static-splitk \
+  --json gqla_hpc_ops.json
+```
+
+The `static` mode disables split-K and is the intended first choice for the
+uniform `B=128`, `L=8192` workload. `static-splitk` is included for direct A/B
+measurements. The GQLA shape extension currently does not accept a dynamic
+`task_map` and forces single-split execution for all four shapes even when
+`static-splitk` is requested.
+
 ## BF16
 
 - Operator: SM90 Attention Decode BF16
diff --git a/benchmark/attention_decode/bench_attention_decode_bf16_gqla.py b/benchmark/attention_decode/bench_attention_decode_bf16_gqla.py
new file mode 100644
index 0000000..94d6770
--- /dev/null
+++ b/benchmark/attention_decode/bench_attention_decode_bf16_gqla.py
@@ -0,0 +1,224 @@
+# Copyright 2026 hpc-ops authors
+
+"""Benchmark the GQLA QK=192/V=128 BF16 paged-decode path.
+
+The default workload matches the GQLA FA3 measurements: B=128, L=8192,
+Hq=128, Hkv in {8, 4}, Sq in {1, 2}, BF16, and a 64-token page.  CUDA-event
+latency covers one complete operator call; ``us_per_sequence`` divides that
+latency by the batch size, matching the reporting convention used by GQLA.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import os
+import sys
+from pathlib import Path
+from statistics import median
+
+import torch
+
+
+sys.path.insert(0, os.path.realpath(list(Path(__file__).parent.glob("../../build/lib.*/"))[0]))
+
+import hpc  # noqa: E402
+
+
+BLOCK_SIZE = 64
+NUM_HEAD_Q = 128
+QK_DIM = 192
+V_DIM = 128
+CASES = ((8, 1), (8, 2), (4, 1), (4, 2))
+MODES = ("static", "static-splitk")
+
+
+def make_inputs(batch: int, seqlen: int, num_head_kv: int, num_seq_q: int):
+    pages_per_sequence = math.ceil(seqlen / BLOCK_SIZE)
+    total_blocks = batch * pages_per_sequence
+
+    torch.manual_seed(2026 + num_head_kv * 10 + num_seq_q)
+    torch.cuda.manual_seed_all(2026 + num_head_kv * 10 + num_seq_q)
+    q = torch.randn(
+        (batch * num_seq_q, NUM_HEAD_Q, QK_DIM),
+        dtype=torch.bfloat16,
+        device="cuda",
+    )
+    kcache = torch.empty(
+        (total_blocks, BLOCK_SIZE, num_head_kv, QK_DIM),
+        dtype=torch.bfloat16,
+        device="cuda",
+    ).uniform_(-1.0, 1.0)
+    vcache = torch.empty(
+        (total_blocks, BLOCK_SIZE, num_head_kv, V_DIM),
+        dtype=torch.bfloat16,
+        device="cuda",
+    ).uniform_(-1.0, 1.0)
+    block_ids = torch.arange(total_blocks, dtype=torch.int32, device="cuda").reshape(
+        batch, pages_per_sequence
+    )
+    total_lens = torch.full((batch,), seqlen, dtype=torch.int32, device="cuda")
+    output = torch.empty(
+        (batch * num_seq_q, NUM_HEAD_Q, V_DIM),
+        dtype=torch.bfloat16,
+        device="cuda",
+    )
+    return q, kcache, vcache, block_ids, total_lens, output
+
+
+def make_call(mode, inputs, num_seq_q):
+    q, kcache, vcache, block_ids, total_lens, output = inputs
+    splitk = mode == "static-splitk"
+
+    def call():
+        hpc.attention_decode_bf16(
+            q,
+            kcache,
+            vcache,
+            block_ids,
+            total_lens,
+            mtp=num_seq_q - 1,
+            new_kv_included=True,
+            splitk=splitk,
+            output=output,
+        )
+
+    return call
+
+
+def benchmark_us(call, warmup: int, iters: int, flush: torch.Tensor | None) -> float:
+    for _ in range(warmup):
+        call()
+    torch.cuda.synchronize()
+
+    samples = []
+    for _ in range(iters):
+        if flush is not None:
+            flush.zero_()
+        start = torch.cuda.Event(enable_timing=True)
+        end = torch.cuda.Event(enable_timing=True)
+        start.record()
+        call()
+        end.record()
+        end.synchronize()
+        samples.append(start.elapsed_time(end) * 1000.0)
+    return float(median(samples))
+
+
+def run_case(args, mode: str, num_head_kv: int, num_seq_q: int, flush):
+    inputs = make_inputs(args.batch, args.seqlen, num_head_kv, num_seq_q)
+    call = make_call(mode, inputs, num_seq_q)
+    call()
+    torch.cuda.synchronize()
+    if not torch.isfinite(inputs[-1]).all():
+        raise RuntimeError("decode output contains NaN or Inf")
+
+    call_us = benchmark_us(call, args.warmup, args.iters, flush)
+    payload_bytes = (
+        args.batch
+        * args.seqlen
+        * num_head_kv
+        * (QK_DIM + V_DIM)
+        * torch.tensor([], dtype=torch.bfloat16).element_size()
+    )
+    result = {
+        "mode": mode,
+        "num_head_kv": num_head_kv,
+        "num_seq_q": num_seq_q,
+        "call_us": call_us,
+        "us_per_sequence": call_us / args.batch,
+        "query_tokens_per_second": args.batch * num_seq_q * 1e6 / call_us,
+        "physical_kv_payload_bytes": payload_bytes,
+        "physical_kv_payload_tb_s": payload_bytes / call_us / 1e6,
+    }
+
+    del call, inputs
+    torch.cuda.empty_cache()
+    return result
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--batch", type=int, default=128)
+    parser.add_argument("--seqlen", type=int, default=8192)
+    parser.add_argument("--warmup", type=int, default=5)
+    parser.add_argument("--iters", type=int, default=20)
+    parser.add_argument(
+        "--modes",
+        nargs="+",
+        choices=MODES,
+        default=["static"],
+        help=(
+            "static disables split-K; static-splitk passes splitk=True, which the GQLA "
+            "extension currently forces back to one split"
+        ),
+    )
+    parser.add_argument(
+        "--flush-gib",
+        type=float,
+        default=8.0,
+        help="bytes zeroed before each timed call to evict L2; use 0 to disable",
+    )
+    parser.add_argument("--json", type=Path)
+    return parser.parse_args()
+
+
+def main():
+    args = parse_args()
+    if args.batch <= 0 or args.seqlen < 2 or args.warmup < 0 or args.iters <= 0:
+        raise ValueError("batch/iters must be positive, seqlen >= 2, and warmup >= 0")
+    if args.flush_gib < 0:
+        raise ValueError("flush-gib must be non-negative")
+
+    props = torch.cuda.get_device_properties(torch.cuda.current_device())
+    if props.major != 9:
+        raise RuntimeError(f"this kernel requires SM90, got capability {props.major}.{props.minor}")
+
+    flush = None
+    if args.flush_gib:
+        flush_elements = int(args.flush_gib * 1024**3 / 4)
+        flush = torch.empty(flush_elements, dtype=torch.float32, device="cuda")
+
+    report = {
+        "device": props.name,
+        "compute_capability": f"{props.major}.{props.minor}",
+        "torch": torch.__version__,
+        "hpc_ops": hpc.__version__,
+        "batch": args.batch,
+        "seqlen": args.seqlen,
+        "num_head_q": NUM_HEAD_Q,
+        "qk_dim": QK_DIM,
+        "v_dim": V_DIM,
+        "block_size": BLOCK_SIZE,
+        "flush_gib": args.flush_gib,
+        "warmup_iterations": args.warmup,
+        "measured_iterations": args.iters,
+        "latency_statistic": "median CUDA-event time for one complete operator call",
+        "results": [],
+    }
+
+    print(
+        f"device={props.name} sm={props.major}.{props.minor} "
+        f"B={args.batch} L={args.seqlen} Hq={NUM_HEAD_Q} QK={QK_DIM} V={V_DIM}"
+    )
+    print("mode            Hkv Sq  call_us  us/sequence  query_tok/s  payload_TB/s")
+    for mode in args.modes:
+        for num_head_kv, num_seq_q in CASES:
+            result = run_case(args, mode, num_head_kv, num_seq_q, flush)
+            report["results"].append(result)
+            print(
+                f"{mode:<16} {num_head_kv:>3} {num_seq_q:>2} "
+                f"{result['call_us']:>8.2f} {result['us_per_sequence']:>12.3f} "
+                f"{result['query_tokens_per_second']:>12.1f} "
+                f"{result['physical_kv_payload_tb_s']:>12.3f}"
+            )
+
+    if args.json:
+        args.json.parent.mkdir(parents=True, exist_ok=True)
+        args.json.write_text(json.dumps(report, indent=2) + "\n")
+        print(f"wrote {args.json}")
+
+
+if __name__ == "__main__":
+    main()
