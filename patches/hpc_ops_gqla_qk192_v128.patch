+# Copyright 2026 hpc-ops authors
+
+"""Correctness coverage for the GQLA BF16 decode shapes."""
+
+import math
+import os
+import sys
+from pathlib import Path
+
+import pytest
+import torch
+
+
+sys.path.insert(0, os.path.realpath(list(Path(__file__).parent.glob("../build/lib.*/"))[0]))
+
+import hpc  # noqa: E402
+
+
+BLOCK_SIZE = 64
+NUM_HEAD_Q = 128
+QK_DIM = 192
+V_DIM = 128
+
+
+def _make_inputs(num_head_kv: int, num_seq_q: int):
+    torch.manual_seed(2026 + num_head_kv * 10 + num_seq_q)
+    torch.cuda.manual_seed_all(2026 + num_head_kv * 10 + num_seq_q)
+
+    total_lens = torch.tensor([70, 129], dtype=torch.int32, device="cuda")
+    num_batch = total_lens.numel()
+    num_blocks = (total_lens + BLOCK_SIZE - 1) // BLOCK_SIZE
+    total_blocks = int(num_blocks.sum().item())
+
+    q = torch.randn(
+        (num_batch * num_seq_q, NUM_HEAD_Q, QK_DIM),
+        dtype=torch.bfloat16,
+        device="cuda",
+    )
+    kcache = torch.randn(
+        (total_blocks, BLOCK_SIZE, num_head_kv, QK_DIM),
+        dtype=torch.bfloat16,
+        device="cuda",
+    )
+    vcache = torch.randn(
+        (total_blocks, BLOCK_SIZE, num_head_kv, V_DIM),
+        dtype=torch.bfloat16,
+        device="cuda",
+    )
+
+    block_ids = torch.zeros(
+        (num_batch, int(num_blocks.max().item())), dtype=torch.int32, device="cuda"
+    )
+    block_offset = 0
+    for batch_idx, batch_blocks in enumerate(num_blocks.tolist()):
+        block_ids[batch_idx, :batch_blocks] = torch.arange(
+            block_offset,
+            block_offset + batch_blocks,
+            dtype=torch.int32,
+            device="cuda",
+        )
+        block_offset += batch_blocks
+
+    return q, kcache, vcache, block_ids, total_lens
+
+
+def _reference(q, kcache, vcache, block_ids, total_lens, num_head_kv, num_seq_q):
+    num_batch = total_lens.numel()
+    heads_per_group = NUM_HEAD_Q // num_head_kv
+    q = q.reshape(num_batch, num_seq_q, NUM_HEAD_Q, QK_DIM)
+    output = torch.empty(
+        (num_batch, num_seq_q, NUM_HEAD_Q, V_DIM),
+        dtype=torch.float32,
+        device="cuda",
+    )
+
+    for batch_idx, total_len_tensor in enumerate(total_lens):
+        total_len = int(total_len_tensor.item())
+        batch_blocks = math.ceil(total_len / BLOCK_SIZE)
+        pages = block_ids[batch_idx, :batch_blocks].long()
+        k = kcache[pages].reshape(-1, num_head_kv, QK_DIM)[:total_len]
+        v = vcache[pages].reshape(-1, num_head_kv, V_DIM)[:total_len]
+
+        q_batch = q[batch_idx].transpose(0, 1).float()
+        k = k.transpose(0, 1).repeat_interleave(heads_per_group, dim=0).float()
+        v = v.transpose(0, 1).repeat_interleave(heads_per_group, dim=0).float()
+
+        scores = torch.matmul(q_batch, k.transpose(-1, -2)) / math.sqrt(QK_DIM)
+        key_positions = torch.arange(total_len, device="cuda")
+        query_limits = total_len - num_seq_q + torch.arange(num_seq_q, device="cuda")
+        causal_mask = key_positions.unsqueeze(0) <= query_limits.unsqueeze(1)
+        probabilities = torch.softmax(scores.masked_fill(~causal_mask, -torch.inf), dim=-1)
+        output[batch_idx] = torch.matmul(probabilities, v).transpose(0, 1)
+
+    return output.reshape(num_batch * num_seq_q, NUM_HEAD_Q, V_DIM).to(torch.bfloat16)
+
+
+def _run_case(num_head_kv: int, num_seq_q: int, splitk: bool, use_output: bool = True):
+    q, kcache, vcache, block_ids, total_lens = _make_inputs(num_head_kv, num_seq_q)
+    expected = _reference(
+        q, kcache, vcache, block_ids, total_lens, num_head_kv, num_seq_q
+    )
+    kwargs = {}
+    if use_output:
+        kwargs["output"] = torch.empty(
+            (q.size(0), NUM_HEAD_Q, V_DIM), dtype=torch.bfloat16, device="cuda"
+        )
+
+    actual = hpc.attention_decode_bf16(
+        q,
+        kcache,
+        vcache,
+        block_ids,
+        total_lens,
+        mtp=num_seq_q - 1,
+        new_kv_included=True,
+        splitk=splitk,
+        **kwargs,
+    )
+    torch.cuda.synchronize()
+
+    if use_output:
+        assert actual.data_ptr() == kwargs["output"].data_ptr()
+    assert actual.shape == (q.size(0), NUM_HEAD_Q, V_DIM)
+    assert torch.isfinite(actual).all()
+    torch.testing.assert_close(actual.float(), expected.float(), atol=0.02, rtol=0.02)
+
+
+@pytest.mark.parametrize("num_head_kv,num_seq_q", [(8, 1), (8, 2), (4, 1), (4, 2)])
+def test_gqla_qk192_v128_static(num_head_kv, num_seq_q):
+    _run_case(num_head_kv, num_seq_q, splitk=False)
+
+
+@pytest.mark.parametrize("num_head_kv,num_seq_q", [(8, 1), (4, 2)])
+def test_gqla_splitk_hint_falls_back_to_single_split(num_head_kv, num_seq_q):
+    _run_case(num_head_kv, num_seq_q, splitk=True)
+
+
+def test_gqla_allocates_v_sized_output():
+    _run_case(num_head_kv=8, num_seq_q=1, splitk=False, use_output=False)
+
+
+def test_gqla_rejects_dynamic_task_map():
+    num_head_kv = 8
+    num_seq_q = 1
+    q, kcache, vcache, block_ids, total_lens = _make_inputs(num_head_kv, num_seq_q)
+    task_map = hpc.get_attention_decode_task_workspace(
+        q.size(0), int(total_lens.max().item()), num_head_kv, min_process_len=64
+    )
+
+    with pytest.raises(RuntimeError, match="currently supports static scheduling only"):
+        hpc.attention_decode_bf16(
+            q,
+            kcache,
+            vcache,
+            block_ids,
+            total_lens,
+            mtp=0,
+            new_kv_included=True,
+            splitk=True,
+            task_map=task_map,
+        )
+
+
+def test_gqla_rejects_unsupported_head_ratio():
+    q = torch.empty((1, 128, QK_DIM), dtype=torch.bfloat16, device="cuda")
+    kcache = torch.empty((1, BLOCK_SIZE, 16, QK_DIM), dtype=torch.bfloat16, device="cuda")
+    vcache = torch.empty((1, BLOCK_SIZE, 16, V_DIM), dtype=torch.bfloat16, device="cuda")
+    block_ids = torch.zeros((1, 1), dtype=torch.int32, device="cuda")
+    total_lens = torch.ones((1,), dtype=torch.int32, device="cuda")
+
+    with pytest.raises(RuntimeError, match="supports num_head_q / num_head_k == 16 or 32"):
+        hpc.attention_decode_bf16(
+            q,
+            kcache,
+            vcache,
+            block_ids,
+            total_lens,
+            mtp=0,
+            new_kv_included=True,
+            splitk=False,
+        )

