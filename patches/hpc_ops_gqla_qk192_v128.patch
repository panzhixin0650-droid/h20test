     Raises:
@@ -401,6 +401,12 @@ def attention_decode_bf16(
         - All input tensors must be on CUDA device and in bfloat16 format
         - The query and key tensors must have the same embedding dimension (num_dim_qk)
         - The batch size (num_batch) must be consistent across all input tensors
+        - Supported decode shapes are:
+          ``(num_dim_qk, num_dim_v) == (128, 128)`` with 4 or 8 query heads
+          per KV head; and ``(192, 128)`` with 16 or 32 query heads per KV
+          head, ``num_seq_q`` equal to 1 or 2, ``block_size`` equal to 64,
+          and static scheduling (``task_map=None``). The GQLA path currently
+          forces single-split execution even when ``splitk=True`` is passed.
     """
     return torch.ops.hpc.attention_decode_bf16(
         q,
