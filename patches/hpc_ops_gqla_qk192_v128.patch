   using Tin = cute::bfloat16_t;
   using Tout = cute::bfloat16_t;
@@ -174,8 +177,8 @@ bool smallm_bf16_dim128_static_async(
     constexpr int kSplitMinLen = decltype(min_len_tag)::value;
     constexpr int kTileM = decltype(tilem_tag)::value;
