+def tp_local_heads_q(tp_size: int) -> int:
+    if tp_size not in TP_SWEEP_SIZES:
+        raise ValueError(
+            f"Unsupported TP size {tp_size}; expected one of {TP_SWEEP_SIZES}"
+        )
+    if NUM_HEADS_Q % tp_size != 0:
+        raise ValueError(
+            f"NUM_HEADS_Q={NUM_HEADS_Q} is not divisible by TP={tp_size}"
+        )
+    return NUM_HEADS_Q // tp_size
+
+
+def tp_local_heads_kv(g: int, tp_size: int) -> tuple[int, int]:
+    """Return local KV heads and replication factor for one simulated TP rank."""
+    tp_local_heads_q(tp_size)
+    if g >= tp_size:
+        if g % tp_size != 0:
+            raise ValueError(f"g={g} is not divisible by TP={tp_size}")
+        return g // tp_size, 1
+    if tp_size % g != 0:
+        raise ValueError(f"TP={tp_size} is not divisible by g={g}")
+    return 1, tp_size // g
+
+
+def tp_work_per_sequence(
+    *,
+    path: str,
+    g: int,
+    s_q: int,
+    tp_size: int,
+) -> dict[str, int]:
+    """Model work and rank-local KV bytes for one simulated TP rank."""
+    tp_local_heads_q(tp_size)
+    if path in ("mqa_absorb", "mla_qv"):
+        global_work = TABLE_WORK[("flashmla_mqa_absorb", 1, s_q)]
+        return {
+            "logical_bytes": global_work["logical_bytes"],
+            "physical_bytes": global_work["physical_bytes"],
+            "flops": global_work["flops"] // tp_size,
+        }
+    if path != "gqa":
+        raise ValueError(f"Unsupported TP path: {path}")
+    local_heads_kv, _ = tp_local_heads_kv(g, tp_size)
+    return {
+        "logical_bytes": (
+            CONTEXT_LEN
+            * (local_heads_kv * (128 + 128) + MLA_ROPE_DIM)
+            * torch.bfloat16.itemsize
+        ),
+        "physical_bytes": (
+            CONTEXT_LEN
+            * local_heads_kv
+            * (GQA_HEAD_DIM + GQA_VALUE_DIM)
+            * torch.bfloat16.itemsize
+        ),
+        "flops": TABLE_WORK[("fa3_gqa", g, s_q)]["flops"] // tp_size,
+    }
+
+
+def tp_point_metadata(*, g: int, tp_size: int) -> dict[str, int | bool]:
+    local_heads_kv, replication_factor = tp_local_heads_kv(g, tp_size)
+    return {
+        "tp_size": tp_size,
+        "simulated_rank": 0,
+        "global_num_heads_q": NUM_HEADS_Q,
+        "local_num_heads_q": tp_local_heads_q(tp_size),
+        "global_num_heads_kv": g,
+        "local_num_heads_kv": local_heads_kv,
+        "kv_replication_factor": replication_factor,
+        "collectives_included": False,
+    }
+
+
