+def require_output_close(
+    label: str,
+    actual: torch.Tensor,
+    reference: torch.Tensor,
+) -> dict[str, Any]:
+    comparison = compare_outputs(actual, reference)
+    if not comparison["allclose"]:
+        raise RuntimeError(
+            f"{label} failed: max_abs={comparison['max_abs']}, "
+            f"mean_abs={comparison['mean_abs']}"
+        )
+    return comparison
+
+
+def pytorch_mla_reference(inputs: dict[str, torch.Tensor]) -> torch.Tensor:
+    """Independent FP32 reference for FA3's qv MLA path.
+
+    Each batch item is evaluated separately so this remains small enough for a
+    smoke test even at L=8192.  The causal mask is bottom-right aligned: for
+    s_q=2, row 0 sees L-1 keys and row 1 sees L keys.
+    """
+    outputs: list[torch.Tensor] = []
+    batch_size, s_q = inputs["q"].shape[:2]
+    for batch_idx in range(batch_size):
+        seqlen_k = int(inputs["cache_seqlens"][batch_idx].item())
+        page_ids = inputs["page_table"][batch_idx].long()
+        k = (
+            inputs["k_cache"]
+            .index_select(0, page_ids)
+            .reshape(-1, 1, MLA_ROPE_DIM)[:seqlen_k, 0]
+            .float()
+        )
+        v = (
+            inputs["v_cache"]
+            .index_select(0, page_ids)
+            .reshape(-1, 1, MLA_VALUE_DIM)[:seqlen_k, 0]
+            .float()
+        )
+        q = inputs["q"][batch_idx].float()
+        qv = inputs["qv"][batch_idx].float()
+        scores = torch.einsum("thd,sd->hts", q, k)
+        scores += torch.einsum("thd,sd->hts", qv, v)
+        scores *= MLA_SOFTMAX_SCALE
+        query_positions = seqlen_k - s_q + torch.arange(
+            s_q,
+            device=scores.device,
+        )
+        key_positions = torch.arange(seqlen_k, device=scores.device)
+        causal_mask = key_positions[None, :] > query_positions[:, None]
+        scores.masked_fill_(causal_mask[None, :, :], -torch.inf)
+        attention = torch.softmax(scores, dim=-1)
+        output = torch.einsum("hts,sd->thd", attention, v)
+        outputs.append(output.to(inputs["q"].dtype))
+    return torch.stack(outputs, dim=0)
+
+
+def split_flashmla_sq2_output(inputs: dict[str, torch.Tensor]) -> torch.Tensor:
+    if inputs["q"].shape[1] != 2:
+        raise ValueError("split_flashmla_sq2_output requires s_q=2")
+    rows: list[torch.Tensor] = []
+    for query_idx, seqlen_k in enumerate((CONTEXT_LEN - 1, CONTEXT_LEN)):
+        row_inputs = dict(inputs)
+        row_inputs["q"] = inputs["q"][:, query_idx : query_idx + 1]
+        row_inputs["cache_seqlens"] = torch.full_like(
+            inputs["cache_seqlens"],
+            seqlen_k,
+        )
+        row_run, _ = make_mla_callable(row_inputs)
+        row_output, _ = row_run()
+        rows.append(row_output)
+    return torch.cat(rows, dim=1)
+
+
+def split_fa3_mla_sq2_output(inputs: dict[str, torch.Tensor]) -> torch.Tensor:
+    if inputs["q"].shape[1] != 2:
+        raise ValueError("split_fa3_mla_sq2_output requires s_q=2")
+    rows: list[torch.Tensor] = []
+    batch_size = inputs["q"].shape[0]
+    for query_idx, seqlen_k in enumerate((CONTEXT_LEN - 1, CONTEXT_LEN)):
+        row_inputs = dict(inputs)
+        row_inputs["q"] = inputs["q"][:, query_idx : query_idx + 1]
+        row_inputs["qv"] = inputs["qv"][:, query_idx : query_idx + 1]
+        row_inputs["cache_seqlens"] = torch.full_like(
+            inputs["cache_seqlens"],
+            seqlen_k,
+        )
+        row_run, _ = make_fa3_mla_callable(
+            row_inputs,
+            batch_size=batch_size,
+            s_q=1,
+            num_splits=1,
+            pack_gqa=True,
+        )
+        rows.append(row_run())
+    return torch.cat(rows, dim=1)
+
