diff --git a/setup.py b/setup.py
index 9dcd654..3c50ed7 100644
--- a/setup.py
+++ b/setup.py
@@ -46,9 +46,19 @@ class CMakeBuild(build_ext):
 
 
 def get_version():
-    git_hash = subprocess.check_output(
-        ["git", "rev-parse", "--short=7", "HEAD"], stderr=subprocess.DEVNULL, text=True
-    ).strip()
+    # Source archives and DLC-mounted code directories do not always retain
+    # .git. The benchmark bootstrap supplies a content-derived seven-character
+    # override so the wheel can still be built and remains traceable to the
+    # exact source tree used for that run.
+    git_hash = os.environ.get("HPC_GIT_HASH_OVERRIDE", "").strip()
+    if not git_hash:
+        git_hash = subprocess.check_output(
+            ["git", "rev-parse", "--short=7", "HEAD"],
+            stderr=subprocess.DEVNULL,
+            text=True,
+        ).strip()
+    if not git_hash.isalnum():
+        raise ValueError(f"invalid HPC git/source hash: {git_hash!r}")
 
     return f"0.0.1.dev0+g{git_hash}", git_hash
 
